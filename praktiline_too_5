SELECT eesnimi,
       (SELECT retsepti_nimi
        FROM retsept
        WHERE retsept.kasutaja_id = kasutaja.kasutaja_id) AS retsept
FROM kasutaja;

SELECT retsepti_nimi,
       (SELECT toiduaine_nimi FROM toiduaine WHERE toiduaine_id =
           (SELECT toiduaine_id FROM koostis WHERE koostis.retsept_retsept_id = retsept.retsept_id)
       ) AS toiduaine,
       (SELECT kogus FROM koostis WHERE koostis.retsept_retsept_id = retsept.retsept_id) AS kogus,
       (SELECT yhik_nimi FROM yhik WHERE yhik_id =
           (SELECT yhik_id FROM koostis WHERE koostis.retsept_retsept_id = retsept.retsept_id)
       ) AS yhik
FROM retsept;

SELECT kategooria_nimi,
       (SELECT COUNT(*)
        FROM retsept
        WHERE retsept.kategooria_id = kategooria.kategooria_id) AS kogus
FROM kategooria;

CREATE PROCEDURE kasutaja_lisa
    @eesnimi VARCHAR(50),
    @perenimi VARCHAR(50),
    @email VARCHAR(150)
AS
BEGIN
    INSERT INTO kasutaja (eesnimi, perenimi, email)
    VALUES (@eesnimi, @perenimi, @email);
END;

CREATE PROCEDURE lisa_retsept
    @nimi VARCHAR(100),
    @kirj VARCHAR(200),
    @juh VARCHAR(500),
    @kp DATE,
    @kasutaja INT,
    @kategooria INT
AS
BEGIN
    INSERT INTO retsept
    (retsepti_nimi, kirjeldus, juhend, sisestatud_kp, kasutaja_id, kategooria_id)
    VALUES
    (@nimi, @kirj, @juh, @kp, @kasutaja, @kategooria);
END;

