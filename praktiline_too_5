CREATE PROCEDURE muuda_tabelit
    @tabeli_nimi VARCHAR(100),
    @veeru_nimi VARCHAR(100),
    @andmetuup VARCHAR(100)
AS
BEGIN
    DECLARE @sql NVARCHAR(MAX);

    SET @sql = 'ALTER TABLE ' + @tabeli_nimi +
               ' ADD ' + @veeru_nimi + ' ' + @andmetuup;

    EXEC sp_executesql @sql;
END;
