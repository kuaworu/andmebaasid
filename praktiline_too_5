CREATE DATABASE retseptiraamat;
USE retseptiraamat;

CREATE TABLE kasutaja (
    kasutaja_id INT IDENTITY(1,1) PRIMARY KEY,
    eesnimi VARCHAR(50),
    perenimi VARCHAR(50),
    email VARCHAR(150)
);

select * from kasutaja;

CREATE TABLE kategooria (
    kategooria_id INT IDENTITY(1,1) PRIMARY KEY,
    kategooria_nimi VARCHAR(50)
);

select * from kategooria;

CREATE TABLE toiduaine (
    toiduaine_id INT IDENTITY(1,1) PRIMARY KEY,
    toiduaine_nimi VARCHAR(100)
);

select * from toiduaine;

CREATE TABLE yhik (
    yhik_id INT IDENTITY(1,1) PRIMARY KEY,
    yhik_nimi VARCHAR(100)
);

select * from yhik;

CREATE TABLE retsept (
    retsept_id INT IDENTITY(1,1) PRIMARY KEY,
    retsepti_nimi VARCHAR(100),
    kirjeldus VARCHAR(200),
    juhend VARCHAR(500),
    sisestatud_kp DATE,
    kasutaja_id INT,
    kategooria_id INT,
    FOREIGN KEY (kasutaja_id) REFERENCES kasutaja(kasutaja_id),
    FOREIGN KEY (kategooria_id) REFERENCES kategooria(kategooria_id)
);

select * from retsept;

CREATE TABLE koostis (
    koostis_id INT IDENTITY(1,1) PRIMARY KEY,
    kogus INT,
    retsept_retsept_id INT,
    toiduaine_id INT,
    yhik_id INT,
    FOREIGN KEY (retsept_retsept_id) REFERENCES retsept(retsept_id),
    FOREIGN KEY (toiduaine_id) REFERENCES toiduaine(toiduaine_id),
    FOREIGN KEY (yhik_id) REFERENCES yhik(yhik_id)
);

select * from koostis;

CREATE TABLE tehtud (
    tehtud_id INT IDENTITY(1,1) PRIMARY KEY,
    tehtud_kp DATE,
    retsept_id INT,
    FOREIGN KEY (retsept_id) REFERENCES retsept(retsept_id)
);

select * from tehtud;


